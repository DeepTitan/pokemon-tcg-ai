{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/share-card.mjs": {
      "includeFiles": "{assets/fonts/**,assets/trace-mascot-og.png,assets/trace-share-background.png,assets/pokemon-card-back.jpg,assets/share-card-catalog.json.gz,assets/share-card-art/**}"
    },
    "api/share-page.mjs": {
      "includeFiles": "assets/share-card-catalog.json.gz"
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/trace/:shareId",
      "destination": "/api/share-page"
    }
  ],
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/bxKJGB9dSY",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/trace-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
