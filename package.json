{
  "name": "pokemon-tcg-ai",
  "version": "1.0.0",
  "description": "Pokemon Trading Card Game AI powered by TensorFlow.js",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "import-cards": "ts-node scripts/import-cards.ts",
    "train": "ts-node src/train.ts",
    "play": "node --import tsx scripts/play.ts",
    "ui": "vite",
    "ui:publish-models": "node --import tsx scripts/publish-ui-models.ts",
    "benchmark": "ts-node src/benchmark.ts",
    "test": "node --import tsx src/engine/__tests__/game-engine.test.ts",
    "test:selfplay-quality": "node --import tsx scripts/__tests__/selfplay-quality.test.ts",
    "test:regret-policy": "node --import tsx scripts/__tests__/regret-policy.test.ts",
    "test:deep-cfr": "node --import tsx scripts/__tests__/deep-cfr.test.ts",
    "test:progress-pruning": "node --import tsx scripts/__tests__/progress-pruning.test.ts",
    "test:energy-cost": "node --import tsx scripts/__tests__/energy-cost.test.ts",
    "test:board-readiness": "node --import tsx scripts/__tests__/board-readiness.test.ts",
    "test:adaptive-controller": "node --import tsx scripts/__tests__/adaptive-controller.test.ts",
    "test:check-gates": "node --import tsx scripts/__tests__/check-gates.test.ts",
    "test:league-manager": "node --import tsx scripts/__tests__/league-manager.test.ts",
    "test:league-limiter": "node --import tsx scripts/__tests__/league-limiter.test.ts",
    "skills:evaluate": "node --import tsx scripts/eval-skills.ts",
    "skills:curriculum": "node --import tsx scripts/generate-skill-curriculum.ts",
    "check:gates": "node --import tsx scripts/check-gates.ts",
    "cfr:kuhn": "node --import tsx scripts/deep-cfr/kuhn-proof.ts --trace --iterations 20000",
    "deep-cfr:curriculum": "bash scripts/deep-cfr/train-teacher-curriculum.sh",
    "league:update": "node --import tsx scripts/league-manager.ts",
    "league:serve": "node --import tsx scripts/league-dashboard-server.ts --port 4000",
    "league:science": "node --import tsx scripts/summarize-scientific-status.ts",
    "league:research": "node --import tsx scripts/save-research-lineage.ts",
    "league:research-continue": "node --import tsx scripts/research-continuation.ts",
    "league:research-fast": "node --import tsx scripts/research-fast-loop.ts",
    "human:build": "node --import tsx scripts/build-human-imitation.ts",
    "human:train": "/usr/bin/python3 training/train.py --data data/human/imitation --weights models/research/latest_weights.json --output models/human_imitation_weights.json --epochs 3 --batch-size 128 --lr 1e-5 --entropy-coef 0.001 --value-loss-weight 0 --selfplay-ratio 0 --require-trajectory-schema",
    "league-limit": "node --import tsx scripts/league-limiter.ts",
    "league-limit:dry-run": "node --import tsx scripts/league-limiter.ts --dry-run",
    "metrics:collect": "node --import tsx scripts/metrics/collect-runs.ts",
    "metrics:dashboard": "node --import tsx scripts/metrics/dashboard.ts",
    "tracker": "vite --open /tracker.html",
    "tracker:build": "vite build --mode tracker",
    "tracker:test": "node --import tsx src/tracker/__tests__/battle-log-parser.test.ts && node --import tsx src/tracker/__tests__/live-operation-reducer.test.ts && node --import tsx src/tracker/__tests__/canonical-review.test.ts && node --import tsx src/tracker/__tests__/card-effect-model.test.ts && node --import tsx src/tracker/__tests__/attack-resolution-model.test.ts && node --import tsx src/tracker/__tests__/damage-change-model.test.ts && node --import tsx src/tracker/__tests__/position-change-model.test.ts && node --import tsx src/tracker/__tests__/timeline-model.test.ts && node --import tsx src/tracker/__tests__/turn-status-model.test.ts && node --import tsx src/tracker/__tests__/key-moment-navigation.test.ts && node --import tsx src/tracker/__tests__/capture-status-model.test.ts && node --import tsx src/tracker/__tests__/archive-summary-model.test.ts && node --import tsx src/tracker/__tests__/match-storage.test.ts && node --import tsx src/tracker/__tests__/card-art.test.ts && node --import tsx src/tracker/__tests__/prize-layout-model.test.ts && node --import tsx src/tracker/__tests__/hand-layout-model.test.ts",
    "release:test": "node scripts/release/trace-release-checkpoint.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tensorflow/tfjs": "^4.11.0",
    "@tensorflow/tfjs-node": "^4.11.0",
    "onnxruntime-node": "^1.24.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.21.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.7"
  }
}
