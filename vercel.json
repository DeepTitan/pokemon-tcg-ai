{
  "buildCommand": "npm --prefix landing ci && node scripts/build-share-runtime.mjs && npm run tracker:build && npm run leaderboard:build && node landing/build.mjs && node --import tsx scripts/build-leaderboard-pages.ts",
  "outputDirectory": "landing/dist",
  "functions": {
    "api/share-card.mjs": {
      "includeFiles": "{landing/assets/fonts/**,landing/assets/trace-mascot-og.png,landing/assets/trace-share-background.png,landing/assets/pokemon-card-back.jpg,landing/assets/share-card-catalog.json.gz,landing/assets/share-card-art/**}"
    },
    "api/share-page.mjs": {
      "includeFiles": "landing/assets/share-card-catalog.json.gz"
    },
    "api/leaderboard-page.mjs": {
      "includeFiles": "landing/assets/leaderboard-pages.json.gz"
    },
    "api/leaderboard-art.mjs": {
      "includeFiles": "{landing/assets/share-card-catalog.json.gz,landing/assets/share-card-art/**}"
    },
    "api/leaderboard-preview.mjs": {
      "includeFiles": "{landing/assets/fonts/**,landing/assets/trace-mascot.png,landing/assets/pokemon-card-back.jpg,landing/assets/share-card-catalog.json.gz,landing/assets/share-card-art/**,landing/leaderboard/card-art/**}",
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/trace/privacy",
      "destination": "/trace-privacy"
    },
    {
      "source": "/trace/api/:action*",
      "destination": "/api/membership?action=:action*"
    },
    {
      "source": "/trace/access",
      "destination": "/api/download-access"
    },
    {
      "source": "/trace",
      "destination": "/"
    },
    {
      "source": "/trace/account",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/login",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/signup",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/confirm",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/recover",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/reset",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/connect",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/link",
      "destination": "/trace-account"
    },
    {
      "source": "/trace/leaderboard-static/training/status.json",
      "destination": "/api/training-data"
    },
    {
      "source": "/trace/training",
      "destination": "/trace/leaderboard-static/training"
    },
    {
      "source": "/trace/leaderboard-preview.png",
      "destination": "/api/leaderboard-preview"
    },
    {
      "source": "/trace/leaderboard-static/events.json",
      "destination": "/api/leaderboard-data"
    },
    {
      "source": "/trace/leaderboard-static/card-art/:cardId.png",
      "destination": "/api/leaderboard-art?cardId=:cardId"
    },
    {
      "source": "/trace/leaderboard",
      "destination": "/api/leaderboard-page"
    },
    {
      "source": "/trace/players/:player",
      "destination": "/api/leaderboard-page?player=:player"
    },
    {
      "source": "/trace/:shareId",
      "destination": "/api/share-page"
    }
  ],
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/bxKJGB9dSY",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/trace-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/trace/(account|login|signup|confirm|recover|reset|connect|link)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/trace-account(.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ]
}
